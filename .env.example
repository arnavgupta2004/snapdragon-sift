# Copy this file to .env and fill in real values. .env is gitignored.

# Which LLM backend app/llm_client.py uses. "local" (default) runs entirely on-device
# via Ollama — no API key, no network call leaves the machine, works on any dev
# machine. "qnn" runs a quantized instruction LLM from Qualcomm AI Hub on the
# Hexagon NPU via ONNX Runtime + the QNN execution provider — only usable on
# Snapdragon hardware (Windows-on-Snapdragon or Android/embedded Linux) with the QNN
# SDK installed. "cloud" uses Gemini as an optional comparison arm (see
# eval/local_vs_cloud.py) and requires GEMINI_API_KEY.
LLM_BACKEND=local

# --- local backend (default; also the fallback on non-Snapdragon dev hardware) ---
# Requires `ollama serve` running and the model pulled: `ollama pull qwen2.5:1.5b`.
# qwen2.5:1.5b is the default because it benchmarked best of 3 candidates on this
# project's routing/explanation tasks — see REPORT.md and eval/local_vs_cloud.py.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- qnn backend (Snapdragon NPU; set LLM_BACKEND=qnn to use) ---
# Directory containing the Qualcomm AI Hub-exported + QNN-compiled instruction LLM
# (genai_config.json + weights + tokenizer). Model: Llama-v3.2-1B-Instruct, quantized
# and compiled for the Hexagon NPU via Qualcomm AI Hub — see README's "NPU backend"
# section for the export/compile steps. Requires `pip install -r requirements-qnn.txt`
# in addition to requirements.txt.
QNN_LLM_MODEL_DIR=
# Path to the Hexagon HTP backend library the QNN execution provider loads
# (QnnHtp.dll on Windows-on-Snapdragon, libQnnHtp.so on Android/embedded Linux).
# Required for both the LLM and CLIP QNN backends below.
QNN_BACKEND_LIB=
QNN_HTP_PERFORMANCE_MODE=burst

# --- cloud backend (optional, set LLM_BACKEND=cloud to use) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Which embedding backend app/embedding_client.py uses for CLIP image/text
# embeddings (app/retrieval/image_search.py's "search images by description"
# feature). "cpu" (default) runs sentence-transformers' clip-ViT-B-32 locally via
# PyTorch — works everywhere, no setup. "qnn" runs a Qualcomm AI Hub-compiled OpenAI
# CLIP ViT-B/32 on the Hexagon NPU via ONNX Runtime's QNN execution provider.
EMBEDDING_BACKEND=cpu
# Directory containing the QNN-compiled CLIP image/text encoder .onnx files (see
# QNN_CLIP_IMAGE_ENCODER_FILENAME / QNN_CLIP_TEXT_ENCODER_FILENAME in app/config.py).
QNN_CLIP_MODEL_DIR=
