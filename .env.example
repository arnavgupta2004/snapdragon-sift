# Copy this file to .env and fill in real values. .env is gitignored.

# Which LLM backend app/llm_client.py uses. "local" (default) runs entirely on-device
# via Ollama — no API key, no network call leaves the machine. "cloud" uses Gemini as
# an optional comparison arm (see eval/local_vs_cloud.py) and requires GEMINI_API_KEY.
LLM_BACKEND=local

# --- local backend (default) ---
# Requires `ollama serve` running and the model pulled: `ollama pull qwen2.5:1.5b`.
# qwen2.5:1.5b is the default because it benchmarked best of 3 candidates on this
# project's routing/explanation tasks — see REPORT.md and eval/local_vs_cloud.py.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- cloud backend (optional, set LLM_BACKEND=cloud to use) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
